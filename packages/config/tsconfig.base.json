{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@mailrith/cli": ["../cli/src/index.ts"],
      "@mailrith/mcp-server": ["../mcp-server/src/index.ts"],
      "@mailrith/public-api": ["../public-api/src/index.ts"],
      "@mailrith/public-api/scopes": ["../public-api/src/scopes.ts"],
      "@mailrith/sdk": ["../sdk/src/index.ts"]
    }
  }
}
