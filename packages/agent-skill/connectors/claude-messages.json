{
  "model": "claude-opus-4-8",
  "max_tokens": 2048,
  "messages": [
    {
      "role": "user",
      "content": "Read my Mailrith workspace capabilities and summarize what this connection can do."
    }
  ],
  "mcp_servers": [
    {
      "type": "url",
      "url": "https://api.mailrith.com/mcp",
      "name": "mailrith",
      "authorization_token": "${MAILRITH_ACCESS_TOKEN}"
    }
  ],
  "tools": [
    {
      "type": "mcp_toolset",
      "mcp_server_name": "mailrith",
      "default_config": {
        "enabled": false,
        "defer_loading": true
      },
      "configs": {
        "mailrith_check_connection": { "enabled": true },
        "mailrith_search_operations": { "enabled": true },
        "mailrith_get_operation": { "enabled": true },
        "mailrith_read": { "enabled": true },
        "mailrith_write": { "enabled": true },
        "mailrith_delete": { "enabled": true },
        "mailrith_live": { "enabled": true }
      }
    }
  ],
  "betas": ["mcp-client-2025-11-20"]
}
